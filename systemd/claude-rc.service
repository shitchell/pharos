[Unit]
Description=Claude Code Remote Control server in ~ (registrations cleansed on start and stop)
Documentation=https://github.com/shitchell/pharos

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/bin/claude-rc-service run
# SIGTERM goes to the wrapper only, so its trap can stop claude rc in order and then
# cleanse. Anything still running after TimeoutStopSec gets SIGKILL.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=90
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
